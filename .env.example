# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Untuk docker compose, DATABASE_URL di-override otomatis ke host "db";
# nilai di bawah dipakai untuk menjalankan aplikasi langsung di host.
# Gunakan password URL-safe (huruf, angka, -, _) agar aman di URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/masjid_abu_dzar?schema=public"

# Password service PostgreSQL di docker-compose.yml (wajib diisi).
# Ganti nilainya; docker compose memakai nilai ini untuk DATABASE_URL juga.
POSTGRES_PASSWORD="postgres"

# Public URL of the app (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Opsional: kredensial Super Admin saat seed pertama kali.
# Seed tidak mereset password akun yang sudah ada.
SEED_ADMIN_EMAIL="fauzi@abudzar.sch.id"
SEED_ADMIN_PASSWORD="masjidabudzar"
