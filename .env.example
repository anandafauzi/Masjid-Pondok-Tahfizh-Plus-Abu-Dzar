# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Untuk docker compose, DATABASE_URL di-override otomatis ke host "db";
# nilai di bawah dipakai untuk menjalankan aplikasi langsung di host.
# Gunakan password URL-safe (huruf, angka, -, _) agar aman di URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/masjid_abu_dzar?schema=public"

# Password service PostgreSQL di docker-compose.yml (wajib diisi).
# Ganti nilainya; docker compose memakai nilai ini untuk DATABASE_URL juga.
POSTGRES_PASSWORD="postgres"

# Public URL of the app (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Opsional: kredensial Super Admin saat seed pertama kali.
# Seed tidak mereset password akun yang sudah ada.
SEED_ADMIN_EMAIL="fauzi@abudzar.sch.id"
SEED_ADMIN_PASSWORD="masjidabudzar"

# ── Pengingat WhatsApp H-1 (WhatsApp Cloud API / Meta) ─────────────────
# Resmi dari Meta. Tidak memakai gateway pihak ketiga.
# Phone number ID dan access token permanen diambil dari Meta Business Suite.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""

# Nama message template yang sudah disetujui Meta. Template harus punya
# 4 variabel body berurutan: {{1}} nama, {{2}} masjid, {{3}} tugas, {{4}} tanggal.
WHATSAPP_CLOUD_TEMPLATE_NAME="pengingat_h1"
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE="id_ID"

# Opsional. Versi Graph API; kosongkan untuk memakai default v26.0.
WHATSAPP_CLOUD_API_VERSION="v26.0"

# Wajib untuk Vercel Cron. Vercel mengirim header Authorization: Bearer <nilai ini>.
# Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me-to-a-long-random-string"

