<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/notif_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:includeFontPadding="true"
        android:lineSpacingMultiplier="1.05"
        android:textAlignment="viewStart"
        android:textColor="@color/notification_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:includeFontPadding="true"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/notification_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans"
            android:includeFontPadding="true"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/notification_text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:text="" />

        <TextView
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="sans"
            android:includeFontPadding="true"
            android:lineSpacingMultiplier="1.05"
            android:maxLines="1"
            android:textAlignment="viewEnd"
            android:textColor="@color/notification_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_staff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans"
        android:includeFontPadding="true"
        android:lineSpacingMultiplier="1.08"
        android:textAlignment="viewStart"
        android:textColor="@color/notification_text_secondary"
        android:textSize="12sp"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/notif_action_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:fontFamily="sans"
        android:includeFontPadding="true"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/notif_action_open"
        android:textColor="@color/notification_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
