<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_compact_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@null"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/notif_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:includeFontPadding="true"
        android:lineSpacingExtra="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/notification_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:includeFontPadding="true"
            android:lineSpacingExtra="1dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/notification_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="sans"
            android:includeFontPadding="true"
            android:lineSpacingExtra="1dp"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/notification_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:text="" />

        <TextView
            android:id="@+id/notif_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="sans"
            android:includeFontPadding="true"
            android:lineSpacingExtra="1dp"
            android:maxLines="1"
            android:textAlignment="viewEnd"
            android:textColor="@color/notification_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_staff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans"
        android:includeFontPadding="true"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/notification_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
